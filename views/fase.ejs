<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head') %>
    <title>Fase <%- numFase %> | Nova 2030</title>
</head>
<body>
    <div class="page">
        <!--Llamada al sidebar-->
        <%- include('partials/sidenavbar') %>

        <!--Llamada al header-->
        <%- include('partials/header') %>

        <!--Si el estado = bloqueado existe, se añade el modifier --locked 
        apaga los clics en css, si hay usuarui activo pero no tiene ese módulo o fase
        desbloqueada, pone la alerta y coloca en grises el contenido
        -->



        <main class = "content <%= modificadorContent%>">
            
        
<% if(modificadorContent === 'content--preview'){ %>
                <%- include('partials/alerta-preview', {tipo: estadoBloqueado})%>
            <% } %>
            <!--Agrupa para poder difumuniar-->
            <div class="content__restricted-area">
                <%- include('partials/fase-informacion') %>
                
                <div class="cards-container">
                    <% submodulos.forEach(sub => { %>
                        <%- include('partials/card-modulos', {sub: sub }) %>
                    
                    <% }) %>
                </div>
            </div>
            <% if(modificadorContent === 'content--locked'){ %>
                <%- include('partials/bloqueo-contenido', { tipo: estadoBloqueado}) %>
            <% } %>
        </main>

        <!--Llamada al sidebar anuncios-->
        <%- include('partials/sidebar-anuncios') %>

        <!--Llamada al footer-->
        <%- include('partials/footer') %>
        
    </div>
    
</body>
</html>