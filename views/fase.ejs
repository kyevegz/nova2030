<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <title>Fase <%- numFase %> | Nova 2030</title>
</head>
<body>
    <div class="page">
        <!--Llamada al sidebar-->
        <%- include('partials/sidenavbar') %>

        <!--Llamada al header-->
        <%- include('partials/header') %>

        <!--Si el estado = bloqueado existe, se añade el modifier --locked 
        apaga los clics en css
        -->
        <main class = "content <%= typeof estadoBloqueado !== 'undefined' && estadoBloqueado ? 'content--locked' :'' %>">

        

            <!--Agrupa para poder difumuniar-->
            <div class=" <%= typeof estadoBloqueado !== 'undefined' && estadoBloqueado ? 'content__restricted-area' :'' %>">
                <%- include('partials/fase-informacion') %>
                <div class="cards-container">
                    <% submodulos.forEach(sub => { %>
                        <%- include('partials/card-modulos', {sub: sub }) %>
                    
                    <% }) %>
                </div>
            </div>
            <% if(typeof estadoBloqueado !== 'undefined' && estadoBloqueado){ %>
                <%- include('partials/bloqueo-contenido', { tipo: estadoBloqueado}) %>
            <% } %>
        </main>

        <!--Llamada al sidebar anuncios-->
        <%- include('partials/sidebar-anuncios') %>

        <!--Llamada al footer-->
        <%- include('partials/footer') %>
        
    </div>
    
</body>
</html>