<nav class="tabs">
    <a href="/asesores?categoria=" 
        class="tabs__link <%= !categoriaSeleccionada || categoriaSeleccionada === 'todas' ? 'tabs__link--active' : ''%>">
        Todos
    </a>

    <% if(categorias && categorias.length >0) {%>
        <% categorias.forEach(cat=> { %>
            <a href="/asesores?categoria=<%=cat.nombre%>" 
                class="tabs__link <%= categoriaSeleccionada === cat.nombre ? 'tabs__link--active' : ''"%>">
                <%=cat.nombre%>
            </a>
        <% }); %>
    <% } %>    
</nav>