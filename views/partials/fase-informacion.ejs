<section class="phase-container">
    <h1 class="phase-title"><%= datosFase.titulo %></h1>
    
    <div class="phase-goal" role="region" aria-label="Objetivo de la <%= datosFase.titulo %>">
        <h2 class="phase-goal__subtitle">
            
            OBJETIVO DE LA FASE
        </h2>
        <p class="phase-goal__text">
            <%= datosFase.objetivo %>
        </p>
    </div>
    


    <div class="notice notice--neutral" role="note">
        <span class="notice__icon">
            <i class="fa-solid fa-info" aria-hidden="true"></i>
        </span>
        <p class="notice__text">
            Completa los módulos progresivamente para ir desbloqueándolos de forma sucesiva
        </p>
    </div>
</section>