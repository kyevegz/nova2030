<article class="card">
    <img src="/images/asesores/image.png" alt="Fotografía del asesor" class="card__image">
    <div class="card__info">
        <div class="card__header card__header--profile">
            <h3 class="card__title"><%= asesor.nombre %> <%= asesor.apellidop %> <%= asesor.apellidom%> </h3>
            <i class="card__icon fa-solid fa-user-gear"></i>

        </div>


        <h3 class="card__degree">
            <strong>Grado:</strong>
            <%= asesor.gradoEscolar %>
        </h3>
        <p class="card__description">
            <%= asesor.descripcion %>
            <br>
            <span class="card__category"><%= asesor.nombreCat %></span>
        </p>

    </div>
</article>