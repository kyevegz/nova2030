<div class="cards-container">
    <% ods.forEach(objetivo => { %>
        
        <article class="flip-card" style="--ods-color: <%= objetivo.color%>">
            <div class="flip-card__inner">
                <div class="flip-card__front">
                    <img alt="" class="flip-card__image" src = "/images/ods/S-WEB-Goal-<%= String(objetivo.id).padStart(2, '0')%>.png">
                    
                </div>

                <div class="flip-card__back">
                    <h2 class="flip-card__title-back">Objetivo <%= objetivo.id%> : <%= objetivo.title %></h2>
                    <p class="flip-card__description"><%= objetivo.description%></p>
                    <a href="/fase/1/modulos/modulo-2/ods/<%= objetivo.id %>" class="flip-card__button">Leer más</a>
                </div>
            </div>
        </article>
    <% }) %>
</div>